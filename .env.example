# --- PayMongo -------------------------------------------------------------
# Both keys come from https://dashboard.paymongo.com/settings
# Secret key: server only. Never prefix this with NEXT_PUBLIC_.
PAYMONGO_SECRET_KEY=
# Public key: used for creating client-side payment methods in an embedded
# checkout. The integration in src/lib/paymongo.ts uses PayMongo-hosted
# checkout instead, so no card data ever touches this app — the key is kept
# here for when an embedded flow is added.
PAYMONGO_PUBLIC_KEY=

# The secret shown when you create a webhook endpoint in the PayMongo
# dashboard. Every request to /api/billing/webhook is HMAC-SHA256 verified
# against it. Without this variable the endpoint rejects everything, which is
# deliberate: an unverified webhook is a free-Pro button.
#
# Note that PayMongo delivers webhooks to a public HTTPS URL, so they cannot
# reach http://localhost:3000. Local development still confirms payments
# because GET /api/billing/status reconciles against the PayMongo API.
PAYMONGO_WEBHOOK_SECRET=

# The absolute origin PayMongo should POST webhooks to, for your own notes —
# e.g. https://yourdomain.com/api/billing/webhook
