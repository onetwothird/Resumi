generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id 
  email        String         @unique
  name         String?
  username     String?        @unique
  role         String?
  location     String?
  bio          String?        @db.Text
  website      String?
  social       String?
  github       String?
  settings     Json?
  
  resumes      Resume[]
  jobs         Job[]
  applications Application[] 
  notifications Notification[]
  receivedMessages Message[] @relation("ReceivedMessages")
  createdAt    DateTime       @default(now())
}

model Resume {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String   @default("Untitled Resume")
  titleIsCustom  Boolean  @default(false)

  firstName      String?
  lastName       String?
  jobTitle       String?
  email          String?
  phone          String?
  address        String?
  summary        String?  @db.Text

  experience     Json?
  education      Json?
  skills         Json?
  certifications String?  @db.Text

  theme          Json?
  blockStyles    Json?

  completionProgress Json?

  atsScore       Int?
  targetJob      String?  @db.Text

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  
  createdAt DateTime @default(now())

  @@index([userId])
}

model Job {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String
  company        String
  location       String?
  remote         Boolean       @default(false)
  employmentType String        @default("Full-time")

  salaryMin      Int?
  salaryMax      Int?

  description    String?       @db.Text
  requirements   String?       @db.Text
  skills         Json?

  posterImageUrl String?

  status         String        @default("draft")
  applications   Application[] 

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model Application {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending, reviewing, interviewing, hired, rejected
  resumeId  String?  
  notes     String?  @db.Text // Add this field for employer notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, userId]) 
  @@index([jobId])
  @@index([userId])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  senderName  String
  content     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

model Testimonial {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  role      String?
  company   String?
  quote     String   @db.Text
  rating    Int      @default(5)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved])
}

/// Fixed-window rate limit counters, one row per (key, window).
///
/// Primary key is the composite (key, windowStart): the upsert in
/// src/lib/rate-limit.ts increments atomically on conflict, so two concurrent
/// requests for the same key cannot both read-then-write a stale count.
///
/// Rows are not deleted by application logic. Sweep them with a periodic job:
///   DELETE FROM "RateLimit" WHERE "windowStart" < now() - interval '2 days';
model RateLimit {
  key         String   @db.Text
  windowStart BigInt
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}