generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id 
  email        String         @unique
  name         String?
  username     String?        @unique
  role         String?
  location     String?
  bio          String?        @db.Text
  website      String?
  social       String?
  github       String?
  settings     Json?

  /// Whether to render this user's email on their public /u/[username] page.
  /// Defaults to false: /u/<username> is world-readable and enumerable, so
  /// showing the address unconditionally turns the profile pages into an
  /// email-harvesting endpoint.
  showEmail    Boolean      @default(false)

  /// Which paid plan this account currently has. "free" is the default and is
  /// what every existing account already is implicitly.
  ///
  /// The catalogue that gives this value meaning is src/lib/plans.ts — this
  /// column deliberately holds no foreign key to a plans table, because the
  /// plan set is defined in code and shipping a price change should not
  /// require a migration.
  plan        String?      @default("free")

  /// Mirrors the payment provider's own lifecycle state once recurring
  /// billing is enabled ("active", "past_due", "cancelled", ...). Null while
  /// access is granted by one-off payments instead of a subscription.
  planStatus  String?

  /// When the paid access runs out. Null means "no expiry recorded".
  ///
  /// A purchase extends from the later of now and the existing expiry, so
  /// renewing early stacks rather than truncating the remaining time.
  planExpiresAt DateTime?

  /// PayMongo Customer id, retained so that enabling recurring billing later
  /// does not orphan the customer record or create a duplicate per user.
  paymongoCustomerId String?

  /// PayMongo Subscription id, once recurring billing is enabled.
  paymongoSubscriptionId String?

  /// Private note kept by staff about this account — why a plan was granted by
  /// hand, who to ask about a dispute, and so on.
  ///
  /// Never selected by any user-facing query and never returned by /api/profile.
  /// It exists so an admin can leave context that outlives the conversation it
  /// was written in, not as a field the account holder can read or write.
  adminNote   String?      @db.Text

  resumes      Resume[]
  jobs         Job[]
  applications Application[] 
  notifications Notification[]
  receivedMessages Message[] @relation("ReceivedMessages")
  payments     Payment[]

  /// Audit rows this admin authored. Cascades: the trail dies with its author,
  /// which is only reachable if the Clerk account itself is deleted.
  adminActions AdminAuditLog[] @relation("AdminAuditActor")

  /// Audit rows about this account. SetNull rather than Cascade on the target:
  /// deleting the audited user must not erase the record that they were once
  /// granted paid access by hand.
  auditEntries AdminAuditLog[] @relation("AdminAuditTarget")

  createdAt    DateTime       @default(now())
}

/// Append-only record of every privileged change made through /admin.
///
/// A plan column can grant someone paid access, so "who set this and why" has
/// to be answerable without trusting anybody's memory. Rows are written by
/// src/lib/admin.ts and are never updated or deleted by application code.
///
/// The values are kept as loose strings rather than a foreign key to a plan
/// table, for the same reason User.plan is: the plan set is defined in code, so
/// a price or plan change must not be able to rewrite history here. A snapshot
/// of the values is more useful in a log than a live reference to them.
model AdminAuditLog {
  id        String   @id @default(cuid())

  /// The admin who made the change. Not the target: these differ whenever an
  /// admin edits someone else's account, which is the normal case here.
  actorId   String
  actor     User     @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  /// The account that was changed. Nullable so an entry can outlive its target.
  targetUserId String?
  target    User?    @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  /// plan.set | payment.mark_paid | user.note — see ADMIN_ACTIONS in
  /// src/lib/admin.ts. Kept as text so a new action does not need a migration.
  action    String

  /// Field before the change, as a display string ("free", "pro"). Null when
  /// the field had no prior value or the action does not touch it.
  fromValue String?

  /// Field after the change. Null for actions that do not set a value.
  toValue   String?

  /// The admin's own words for the change. Required: an unexplained grant of
  /// paid access is indistinguishable from a mistake, and this is the only
  /// place that context is captured.
  note      String   @db.Text

  /// When the change was effective from, for plan grants. Kept apart from
  /// createdAt (when it was typed) so a backdated grant is legible.
  effectiveAt DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
  @@index([actorId])
}

/// One attempted purchase of a paid plan, from the moment a checkout session
/// is created until it is confirmed paid, failed, or abandoned.
///
/// A row exists before the customer is redirected, so the amount that was
/// offered can always be reconciled against what PayMongo actually collected.
model Payment {
  id       String @id @default(cuid())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String @default("paymongo")

  /// "pro" | "premium" — matches PlanId in src/lib/plans.ts.
  plan     String

  /// "month" | "year" — matches BillingInterval in src/lib/plans.ts.
  interval String

  /// Amount in centavos, snapshotted at checkout time. Deliberately NOT read
  /// back from the catalogue later: a price change must not rewrite the
  /// history of what someone was charged.
  amount   Int
  currency String @default("PHP")

  /// pending | paid | failed | expired
  status   String @default("pending")

  /// The PayMongo checkout session (cs_...). Unique, so a replayed webhook or a
  /// double-clicked button cannot create two rows for one charge.
  checkoutSessionId String? @unique

  /// Populated once PayMongo reports a matching payment.
  paymongoPaymentId String?
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Resume {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String   @default("Untitled Resume")
  titleIsCustom  Boolean  @default(false)

  firstName      String?
  lastName       String?
  jobTitle       String?
  email          String?
  phone          String?
  address        String?
  summary        String?  @db.Text

  experience     Json?
  education      Json?
  skills         Json?
  certifications String?  @db.Text

  theme          Json?
  blockStyles    Json?

  completionProgress Json?

  atsScore       Int?
  targetJob      String?  @db.Text

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  
  createdAt DateTime @default(now())

  @@index([userId])
}

model Job {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String
  company        String
  location       String?
  remote         Boolean       @default(false)
  employmentType String        @default("Full-time")

  salaryMin      Int?
  salaryMax      Int?

  description    String?       @db.Text
  requirements   String?       @db.Text
  skills         Json?

  posterImageUrl String?

  status         String        @default("draft")
  applications   Application[] 

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model Application {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending, reviewing, interviewing, hired, rejected
  resumeId  String?  
  notes     String?  @db.Text // Add this field for employer notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, userId]) 
  @@index([jobId])
  @@index([userId])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  senderName  String
  content     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

model Testimonial {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  role      String?
  company   String?
  quote     String   @db.Text
  rating    Int      @default(5)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved])
}

/// Fixed-window rate limit counters, one row per (key, window).
///
/// Primary key is the composite (key, windowStart): the upsert in
/// src/lib/rate-limit.ts increments atomically on conflict, so two concurrent
/// requests for the same key cannot both read-then-write a stale count.
///
/// Rows are not deleted by application logic. Sweep them with a periodic job:
///   DELETE FROM "RateLimit" WHERE "windowStart" < now() - interval '2 days';
model RateLimit {
  key         String   @db.Text
  windowStart BigInt
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}