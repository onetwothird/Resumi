generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id 
  email        String         @unique
  name         String?
  username     String?        @unique
  role         String?
  location     String?
  bio          String?        @db.Text
  website      String?
  social       String?
  github       String?
  
  resumes      Resume[]
  jobs         Job[]
  applications Application[] 
  notifications Notification[]
  receivedMessages Message[] @relation("ReceivedMessages")
  createdAt    DateTime       @default(now())
}

model Resume {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String   @default("Untitled Resume")
  titleIsCustom  Boolean  @default(false)

  firstName      String?
  lastName       String?
  jobTitle       String?
  email          String?
  phone          String?
  address        String?
  summary        String?  @db.Text

  experience     Json?
  education      Json?
  skills         Json?
  certifications String?  @db.Text

  theme          Json?
  blockStyles    Json?

  atsScore       Int?
  targetJob      String?  @db.Text

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  
  createdAt DateTime @default(now())

  @@index([userId])
}

model Job {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String
  company        String
  location       String?
  remote         Boolean       @default(false)
  employmentType String        @default("Full-time")

  salaryMin      Int?
  salaryMax      Int?

  description    String?       @db.Text
  requirements   String?       @db.Text
  skills         Json?

  posterImageUrl String?

  status         String        @default("draft")
  applications   Application[] 

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model Application {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending, reviewing, interviewing, hired, rejected
  resumeId  String?  
  notes     String?  @db.Text // Add this field for employer notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, userId]) 
  @@index([jobId])
  @@index([userId])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  senderName  String
  content     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId])
}